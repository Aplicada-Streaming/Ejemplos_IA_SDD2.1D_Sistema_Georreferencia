@page "/usuarios"
@inject ClienteApi Api
@inject EstadoSesion Sesion
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Usuarios — GeoVial</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Administración de usuarios</MudText>

@if (_rolAdministrable is { } rolAdmin)
{
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Dar de alta un @rolAdmin.Texto().ToLowerInvariant()</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_nuevoNombre" Label="Nombre de usuario" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_nuevaContrasena" Label="Contraseña" InputType="InputType.Password" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearAsync" Disabled="_ocupado">
                    Crear
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

<MudPaper Elevation="1">
    <MudTable Items="_usuarios" Hover="true" Dense="true" Loading="_cargando">
        <HeaderContent>
            <MudTh>Usuario</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Alta</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Usuario">@context.NombreUsuario</MudTd>
            <MudTd DataLabel="Rol">@context.Rol.Texto()</MudTd>
            <MudTd DataLabel="Estado">@(context.Activo ? "Activo" : "De baja")</MudTd>
            <MudTd DataLabel="Alta">@context.FechaAlta.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                @if (context.Activo)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                               OnClick="@(() => DarDeBajaAsync(context))">Dar de baja</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay usuarios administrados todavía.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<UsuarioDto> _usuarios = [];
    private Rol? _rolAdministrable;
    private string _nuevoNombre = string.Empty;
    private string _nuevaContrasena = string.Empty;
    private bool _cargando = true;
    private bool _ocupado;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _rolAdministrable = RolQueAdministra(Sesion.Usuario!.Rol);
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        _cargando = true;
        try
        {
            _usuarios = await Api.ListarUsuariosAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CrearAsync()
    {
        if (_rolAdministrable is not { } rol || string.IsNullOrWhiteSpace(_nuevoNombre) || string.IsNullOrWhiteSpace(_nuevaContrasena))
        {
            Snackbar.Add("Completá nombre y contraseña.", Severity.Warning);
            return;
        }

        _ocupado = true;
        try
        {
            await Api.CrearUsuarioAsync(new SolicitudCrearUsuario(_nuevoNombre.Trim(), _nuevaContrasena, rol));
            Snackbar.Add($"Usuario '{_nuevoNombre.Trim().ToLowerInvariant()}' creado.", Severity.Success);
            _nuevoNombre = string.Empty;
            _nuevaContrasena = string.Empty;
            await RecargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task DarDeBajaAsync(UsuarioDto usuario)
    {
        try
        {
            await Api.DarDeBajaAsync(usuario.Id);
            Snackbar.Add($"Usuario '{usuario.NombreUsuario}' dado de baja.", Severity.Success);
            await RecargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Rol? RolQueAdministra(Rol rol) => rol switch
    {
        Rol.Raiz => Rol.JefeGeneral,
        Rol.JefeGeneral => Rol.JefeDeArea,
        Rol.JefeDeArea => Rol.AgenteDeCampo,
        _ => null,
    };
}
