@page "/relevamientos"
@inject ClienteApi Api
@inject EstadoSesion Sesion
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Relevamientos — GeoVial</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Relevamientos viales</MudText>

@if (_esJefeArea)
{
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Crear un relevamiento</MudText>
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_nuevoNombre" Label="Nombre" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_nuevoTramo" Label="Tramo vial" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearAsync" Disabled="_ocupado">
                    Crear
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

<MudPaper Elevation="1">
    <MudTable Items="_relevamientos" Hover="true" Dense="true" Loading="_cargando">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Tramo</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Marcadores</MudTh>
            <MudTh>Agentes</MudTh>
            <MudTh>Creado</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Tramo">@context.TramoVial</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@ColorEstado(context.Estado)">@context.Estado.Texto()</MudChip>
            </MudTd>
            <MudTd DataLabel="Marcadores">@context.CantidadMarcadores</MudTd>
            <MudTd DataLabel="Agentes">@context.CantidadAgentes</MudTd>
            <MudTd DataLabel="Creado">@context.FechaCreacion.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                           Href="@($"/relevamientos/{context.Id}")">Ver mapa</MudButton>
                @if (_esJefeArea && context.Estado.Siguiente() is { } siguiente)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                               OnClick="@(() => AvanzarAsync(context, siguiente))" Disabled="_ocupado">
                        Avanzar a @siguiente.Texto().ToLowerInvariant()
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay relevamientos todavía.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<RelevamientoDto> _relevamientos = [];
    private bool _esJefeArea;
    private string _nuevoNombre = string.Empty;
    private string _nuevoTramo = string.Empty;
    private bool _cargando = true;
    private bool _ocupado;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _esJefeArea = Sesion.Usuario!.Rol == Rol.JefeDeArea;
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        _cargando = true;
        try
        {
            _relevamientos = await Api.ListarRelevamientosAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CrearAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoNombre) || string.IsNullOrWhiteSpace(_nuevoTramo))
        {
            Snackbar.Add("Completá nombre y tramo vial.", Severity.Warning);
            return;
        }

        _ocupado = true;
        try
        {
            await Api.CrearRelevamientoAsync(new CrearRelevamientoRequest(_nuevoNombre.Trim(), _nuevoTramo.Trim()));
            Snackbar.Add($"Relevamiento '{_nuevoNombre.Trim()}' creado.", Severity.Success);
            _nuevoNombre = string.Empty;
            _nuevoTramo = string.Empty;
            await RecargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task AvanzarAsync(RelevamientoDto rel, EstadoRelevamiento nuevo)
    {
        _ocupado = true;
        try
        {
            await Api.CambiarEstadoRelevamientoAsync(rel.Id, nuevo);
            Snackbar.Add($"'{rel.Nombre}' pasó a {nuevo.Texto().ToLowerInvariant()}.", Severity.Success);
            await RecargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static Color ColorEstado(EstadoRelevamiento estado) => estado switch
    {
        EstadoRelevamiento.Recoleccion => Color.Info,
        EstadoRelevamiento.Revision => Color.Warning,
        EstadoRelevamiento.Cerrado => Color.Success,
        _ => Color.Default,
    };
}
