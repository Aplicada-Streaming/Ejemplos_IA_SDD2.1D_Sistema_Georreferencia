@page "/relevamientos/{Id:guid}"
@inject ClienteApi Api
@inject EstadoSesion Sesion
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Relevamiento — GeoVial</PageTitle>

<MudButton Href="/relevamientos" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Class="mb-4">
    Volver a relevamientos
</MudButton>

@if (_relevamiento is { } rel)
{
    <MudText Typo="Typo.h4" Class="mb-1">@rel.Nombre</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-4">
        @rel.TramoVial — <MudChip T="string" Size="Size.Small" Color="@ColorEstado(rel.Estado)">@rel.Estado.Texto()</MudChip>
    </MudText>

    @if (_esJefe)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Estado del relevamiento</MudText>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var destino in TransicionesDisponibles(rel.Estado))
                {
                    <MudButton Variant="Variant.Filled"
                               Color="@(destino == EstadoRelevamiento.Cerrado ? Color.Success : Color.Primary)"
                               OnClick="@(() => TransicionarAsync(destino))" Disabled="_ocupado">
                        @TextoTransicion(rel.Estado, destino)
                    </MudButton>
                }
            </div>
        </MudPaper>
    }

    @if (_esJefe && _conflictos.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Conflictos de marcadores (@_conflictos.Count)</MudText>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                Hay conflictos pendientes; resolvelos (unificar o separar) antes de cerrar el relevamiento.
                @if (!EnRevision)
                {
                    <text> Pasá el relevamiento a revisión para poder resolverlos.</text>
                }
            </MudAlert>
            @foreach (var conflicto in _conflictos)
            {
                <MudPaper Class="pa-3 mb-2" Outlined="true">
                    <MudText Typo="Typo.body2" Class="mb-1">Marcadores en conflicto:</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var m in conflicto.Marcadores)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Place"
                                         Text="@($"{(string.IsNullOrWhiteSpace(m.Descripcion) ? "(sin descripción)" : m.Descripcion)} — {m.Latitud.ToString("0.00000")}, {m.Longitud.ToString("0.00000")}")" />
                        }
                    </MudList>
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_ocupado || !EnRevision)"
                                   OnClick="@(() => ResolverAsync(conflicto.Id, ResolucionConflicto.Unificar))">Unificar</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Disabled="@(_ocupado || !EnRevision)"
                                   OnClick="@(() => ResolverAsync(conflicto.Id, ResolucionConflicto.Separar))">Separar</MudButton>
                    </div>
                </MudPaper>
            }
        </MudPaper>
    }

    <div @ref="_mapaElemento" style="height: 480px; width: 100%; border-radius: 4px;"></div>

    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Marcadores (@_marcadores.Count)</MudText>
    <MudPaper Elevation="1">
        <MudTable Items="_marcadores" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Latitud</MudTh>
                <MudTh>Longitud</MudTh>
                <MudTh>Descripción</MudTh>
                <MudTh>Observaciones</MudTh>
                <MudTh>Etiquetas</MudTh>
                <MudTh>Creado</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Latitud">@context.Latitud.ToString("0.00000")</MudTd>
                <MudTd DataLabel="Longitud">@context.Longitud.ToString("0.00000")</MudTd>
                <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
                <MudTd DataLabel="Observaciones">@context.CantidadObservaciones</MudTd>
                <MudTd DataLabel="Etiquetas">
                    @foreach (var etiqueta in context.Etiquetas)
                    {
                        <MudChip T="string" Size="Size.Small" Class="ma-1">@etiqueta</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Creado">@context.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PhotoLibrary"
                               OnClick="@(() => VerFotosAsync(context.Id))">Fotos</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Todavía no hay marcadores.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_marcadorFotos is not null)
    {
        <MudPaper Class="pa-4 mt-4" Elevation="1">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h6">Fotos del marcador (@_fotos.Count)</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _marcadorFotos = null)" />
            </div>
            @if (_cargandoFotos)
            {
                <MudProgressLinear Indeterminate="true" Class="my-2" />
            }
            else if (_fotos.Count == 0)
            {
                <MudText>Este marcador no tiene fotos.</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (var foto in _fotos)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Outlined="true">
                                @if (_imagenes.TryGetValue(foto.Id, out var dataUri))
                                {
                                    <MudImage Src="@dataUri" Height="180" ObjectFit="ObjectFit.Cover" Fluid="true" />
                                }
                                <MudCardContent>
                                    <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(foto.Comentario) ? "(sin comentario)" : foto.Comentario)</MudText>
                                    <MudText Typo="Typo.caption">
                                        @(foto.PendienteUbicacion
                                            ? "Ubicación pendiente"
                                            : $"{foto.Latitud?.ToString("0.00000")}, {foto.Longitud?.ToString("0.00000")}")
                                    </MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    }
}
else if (_cargado)
{
    <MudAlert Severity="Severity.Warning">No se encontró el relevamiento o no tenés acceso.</MudAlert>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private RelevamientoDto? _relevamiento;
    private IReadOnlyList<MarcadorDto> _marcadores = [];
    private IReadOnlyList<ConflictoDto> _conflictos = [];
    private string _descripcionNueva = string.Empty;
    private bool _cargado;
    private bool _esJefe;
    private bool _puedeEditar;
    private bool _ocupado;

    private Guid? _marcadorFotos;
    private IReadOnlyList<FotoDto> _fotos = [];
    private readonly Dictionary<Guid, string> _imagenes = [];
    private bool _cargandoFotos;

    private ElementReference _mapaElemento;
    private IJSObjectReference? _modulo;
    private DotNetObjectReference<RelevamientoDetalle>? _refDotNet;
    private bool _mapaInicializado;

    private bool EnRevision => _relevamiento?.Estado == EstadoRelevamiento.Revision;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _esJefe = Sesion.Usuario!.Rol == Rol.JefeDeArea;

        try
        {
            var relevamientos = await Api.ListarRelevamientosAsync();
            _relevamiento = relevamientos.FirstOrDefault(r => r.Id == Id);
            if (_relevamiento is { } rel)
            {
                _puedeEditar = _esJefe && rel.Estado != EstadoRelevamiento.Cerrado;
                _marcadores = await Api.ListarMarcadoresAsync(Id);
                await RecargarConflictosAsync();
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargado = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapaInicializado || _relevamiento is null || !Sesion.EstaAutenticado)
        {
            return;
        }

        _modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapa.js");
        _refDotNet ??= DotNetObjectReference.Create(this);

        var pines = _marcadores
            .Select(m => new { latitud = m.Latitud, longitud = m.Longitud, descripcion = m.Descripcion })
            .ToArray();

        // Centro por defecto: Buenos Aires con zoom amplio si no hay marcadores aún.
        double lat = pines.Length > 0 ? pines[0].latitud : -34.6037;
        double lng = pines.Length > 0 ? pines[0].longitud : -58.3816;
        int zoom = pines.Length > 0 ? 13 : 6;

        await _modulo.InvokeVoidAsync("inicializar", _mapaElemento, _puedeEditar ? _refDotNet : null, lat, lng, zoom, pines);
        _mapaInicializado = true;
    }

    [JSInvokable]
    public async Task AlHacerClicEnMapa(double lat, double lng)
    {
        if (!_puedeEditar)
        {
            return;
        }

        try
        {
            var creado = await Api.CrearMarcadorAsync(Id, new CrearMarcadorRequest(lat, lng, EsVacio(_descripcionNueva) ? null : _descripcionNueva.Trim()));
            _marcadores = [.. _marcadores, creado];
            if (_modulo is not null)
            {
                await _modulo.InvokeVoidAsync("agregarMarcador", _mapaElemento, creado.Latitud, creado.Longitud, creado.Descripcion);
            }

            await RecargarConflictosAsync();
            Snackbar.Add("Marcador agregado.", Severity.Success);
            StateHasChanged();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task TransicionarAsync(EstadoRelevamiento destino)
    {
        _ocupado = true;
        try
        {
            _relevamiento = await Api.CambiarEstadoRelevamientoAsync(Id, destino);
            _puedeEditar = _esJefe && _relevamiento.Estado != EstadoRelevamiento.Cerrado;
            await RecargarConflictosAsync();
            Snackbar.Add($"Relevamiento en {_relevamiento.Estado.Texto().ToLowerInvariant()}.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task ResolverAsync(Guid idConflicto, ResolucionConflicto resolucion)
    {
        _ocupado = true;
        try
        {
            await Api.ResolverConflictoAsync(Id, idConflicto, resolucion);
            // Unificar reasigna observaciones y elimina marcadores: recargar tabla y mapa.
            _marcadores = await Api.ListarMarcadoresAsync(Id);
            await RecargarConflictosAsync();
            await ReinicializarMapaAsync();
            Snackbar.Add(resolucion == ResolucionConflicto.Unificar ? "Marcadores unificados." : "Conflicto resuelto (separados).", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task VerFotosAsync(Guid idMarcador)
    {
        _marcadorFotos = idMarcador;
        _fotos = [];
        _imagenes.Clear();
        _cargandoFotos = true;
        try
        {
            _fotos = await Api.ListarFotosPorMarcadorAsync(Id, idMarcador);
            foreach (var foto in _fotos)
            {
                var bytes = await Api.DescargarFotoAsync(Id, foto.Id);
                _imagenes[foto.Id] = $"data:{foto.ContentType};base64,{Convert.ToBase64String(bytes)}";
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargandoFotos = false;
        }
    }

    private async Task RecargarConflictosAsync()
    {
        if (!_esJefe)
        {
            return;
        }

        try
        {
            _conflictos = await Api.ListarConflictosAsync(Id);
        }
        catch (ApiException)
        {
            // Los conflictos son complementarios; si no hay acceso, no se interrumpe la vista.
            _conflictos = [];
        }
    }

    private async Task ReinicializarMapaAsync()
    {
        if (_modulo is null || !_mapaInicializado)
        {
            return;
        }

        try
        {
            await _modulo.InvokeVoidAsync("destruir", _mapaElemento);
        }
        catch (JSException)
        {
            // Si el mapa ya no está disponible, la próxima renderización lo recrea.
        }

        _mapaInicializado = false; // OnAfterRenderAsync vuelve a inicializarlo con los marcadores actuales.
    }

    private static IReadOnlyList<EstadoRelevamiento> TransicionesDisponibles(EstadoRelevamiento estado) => estado switch
    {
        EstadoRelevamiento.Recoleccion => [EstadoRelevamiento.Revision],
        EstadoRelevamiento.Revision => [EstadoRelevamiento.Recoleccion, EstadoRelevamiento.Cerrado],
        EstadoRelevamiento.Cerrado => [EstadoRelevamiento.Revision],
        _ => [],
    };

    private static string TextoTransicion(EstadoRelevamiento origen, EstadoRelevamiento destino) => (origen, destino) switch
    {
        (_, EstadoRelevamiento.Cerrado) => "Cerrar relevamiento",
        (EstadoRelevamiento.Cerrado, EstadoRelevamiento.Revision) => "Reabrir (a revisión)",
        (EstadoRelevamiento.Revision, EstadoRelevamiento.Recoleccion) => "Volver a recolección",
        (_, EstadoRelevamiento.Revision) => "Pasar a revisión",
        _ => $"Pasar a {destino.Texto().ToLowerInvariant()}",
    };

    private static Color ColorEstado(EstadoRelevamiento estado) => estado switch
    {
        EstadoRelevamiento.Recoleccion => Color.Info,
        EstadoRelevamiento.Revision => Color.Warning,
        EstadoRelevamiento.Cerrado => Color.Success,
        _ => Color.Default,
    };

    private static bool EsVacio(string? s) => string.IsNullOrWhiteSpace(s);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_modulo is not null)
            {
                await _modulo.InvokeVoidAsync("destruir", _mapaElemento);
                await _modulo.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // El circuito ya se cerró; no hay nada que limpiar del lado del navegador.
        }

        _refDotNet?.Dispose();
    }
}
